{
  "name": "rival-engineers",
  "private": true,
  "type": "module",
  "scripts": {
    "status": "node tools/project-status.mjs",
    "doctor": "node tools/doctor.mjs",
    "diagnose": "node tools/diagnose.mjs",
    "check:architecture": "node tools/check-architecture.mjs",
    "build": "node tools/build-mod.mjs",
    "typecheck": "node tools/check-architecture.mjs && tsc -p mod/tsconfig.json --noEmit && tsc -p mod/tsconfig.settings.json --noEmit && tsc -p mod/tsconfig.unit.json --noEmit",
    "test:unit": "node tools/run-unit-tests.mjs",
    "replay:sweep": "node tools/replay-sweep.mjs",
    "test": "node tools/test-parallel.mjs",
    "test:serial": "npm run build && factorio-test run",
    "soak": "python3 tools/harness/soak.py",
    "review": "node tools/review/review.mjs"
  },
  "devDependencies": {
    "factorio-test": "3.1.0",
    "factorio-test-cli": "3.8.0",
    "typed-factorio": "3.36.0",
    "typescript": "6.0.2",
    "typescript-to-lua": "1.37.1"
  }
}
