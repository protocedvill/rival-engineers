{
  "name": "rival-engineers",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node tools/build-mod.mjs",
    "typecheck": "tsc -p mod/tsconfig.json --noEmit && tsc -p mod/tsconfig.settings.json --noEmit && tsc -p mod/tsconfig.unit.json --noEmit",
    "test:unit": "node tools/run-unit-tests.mjs",
    "test": "npm run build && factorio-test run",
    "soak": "python3 tools/harness/soak.py"
  },
  "devDependencies": {
    "factorio-test": "3.1.0",
    "factorio-test-cli": "3.8.0",
    "typed-factorio": "3.36.0",
    "typescript": "6.0.2",
    "typescript-to-lua": "1.37.1"
  }
}
